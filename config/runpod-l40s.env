# Runtime only. Source from the project root AFTER downloading public weights.
# Contains no credentials and does not activate an unreviewed rules factory.
FORTE_MODEL_DIR=models/Qwen3-VL-32B-Instruct
FORTE_PEOPLE_MODEL_DIR=models/rtdetr
FORTE_OBJECT_MODEL_DIR=models/owlv2
# Measured cold loading may exceed 180 s; this does NOT extend any job deadline.
FORTE_STARTUP_TIMEOUT=360
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_PROGRESS_BARS=1
YOLO_OFFLINE=True
YOLO_AUTOINSTALL=False
